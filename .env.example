# Copy to .env.local and fill in. Never commit real values.

# --- GitHub App (repo access; lets share links work without the viewer logging in) ---
# Numeric App ID from https://github.com/settings/apps/<your-app>
GITHUB_APP_ID=
# The App's private key (PEM). Paste with literal \n for newlines, or base64-encode it.
GITHUB_APP_PRIVATE_KEY=
# The App's slug, used to build the "Install" link (github.com/apps/<slug>/installations/new)
GITHUB_APP_SLUG=
# Secret for GitHub App webhooks (App settings → Webhook secret). Signed deliveries to
# /api/github/webhook refresh a repo's cached data. Optional: without it, data refreshes
# every 5 minutes or when you press Sync.
GITHUB_WEBHOOK_SECRET=
# Optional: GitHub API base URL. Leave empty for github.com (e2e tests point it at a mock)
GITHUB_API_URL=

# --- Auth.js (owner sign-in with GitHub) ---
# OAuth client ID/secret. The GitHub App's own client credentials work here.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Random secret for signing sessions. Generate with: openssl rand -base64 32
AUTH_SECRET=
# Only this GitHub login may sign in as the owner (Outpost is single-owner)
OWNER_GITHUB_LOGIN=

# --- Vercel (optional, not used yet) ---
# Deployments come from GitHub Deployments, which Vercel already reports to.
# A token from https://vercel.com/account/tokens is only needed for future Vercel-only details.
VERCEL_TOKEN=
# Optional: team ID if the project lives under a Vercel team
VERCEL_TEAM_ID=

# --- Database (Neon Postgres) ---
# Pooled connection string from the Neon dashboard, e.g. postgres://user:pass@host/db?sslmode=require
# (any Postgres works; the app uses the standard pg driver)
DATABASE_URL=
